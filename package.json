{
  "name": "coachman",
  "private": true,
  "version": "0.1.0",
  "description": "CoachMan (coach manager): clients, progress, packages, groups, schedule, and money for pickleball coaches.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=desktop",
    "vapid:generate": "node scripts/vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:academy": "node scripts/academy-screenshots.mjs",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production vite build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@pushforge/builder": "^2.0.5",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "better-auth": "^1.7.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.57.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.151.0"
  }
}
